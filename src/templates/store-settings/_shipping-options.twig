{% extends 'commerce-sendcloud/_layouts/store-settings' %}

{% block content %}
    <h3>{{ "Shipping options"|t('commerce-sendcloud') }}</h3>
    <p>
        {{ "List of available Sendcloud shipping options. Only options for the countries enabled in Craft Commerce settings panel are displayed here."|t('commerce-sendcloud') }}
        {{ "To create a Craft Commerce method, click the plus-button or manually create a shipping method."|t('commerce-sendcloud') }}
        {{ "Make sure the name of the Craft shipping method exactly matches the name of the of the Sendcloud shipping option!"|t('commerce-sendcloud') }}
    </p>
    <table id="shippingMethods" class="fullwidth data">
        <thead>
        <tr>
            <th scope="col" class="select-cell">{{ "Name"|t('commerce-sendcloud') }}</th>
            <th scope="col" class="select-cell">{{ "Carrier"|t('commerce-sendcloud') }}</th>
            <th scope="col" class="select-cell">{{ "Min. Weight, kg."|t('commerce-sendcloud') }}</th>
            <th scope="col" class="select-cell">{{ "Max. Weight, kg."|t('commerce-sendcloud') }}</th>
            <th scope="col" class="select-cell">{{ "Service Points"|t('commerce-sendcloud') }}</th>
            <th colspan="2"></th>
        </tr>
        </thead>
        <tbody>
        {% for shippingOption in shippingOptions %}
            <tr>
                <td>
                    {% if shippingOption.craftMethodId is not null %}
                        <a href="{{ cpUrl('commerce/store-management/' ~ storeHandle ~ '/shippingmethods/' ~ shippingOption.craftMethodId) }}" target="_blank">{{ shippingOption.name }}</a>
                    {% else %}
                        <span>{{ shippingOption.name }}</span>
                    {% endif %}
                </td>
                <td>{{ shippingOption.carrier }}</td>
                <td>{{ shippingOption.minWeight }}</td>
                <td>{{ shippingOption.maxWeight }}</td>
                <td>{{ shippingOption.servicePointInputRequired ? '&check;' : '' }}</td>
                <td>
                    {% if shippingOption.craftMethodId is not null %}
                        &check;
                    {% else %}
                        <a
                            href="#" class="create-shipping-method add icon"
                            title="{{ 'Create'|t('commerce-sendcloud') }}"
                            data-name="{{ shippingOption.name }}"
                        ></a>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {% if false %}
    <script>{% endif %}
    {% js %}
        var shippingMethodsTable = $('#shippingMethods tbody');

        shippingMethodsTable.on('click', '.create-shipping-method', function (e) {
            e.preventDefault();
            var shippingOption = $(this).data();
            var gen = new Craft.HandleGenerator('', '');

            $('<form/>')
                .attr('method', 'post')
                .attr('target', '_blank')
                .append($('<input/>').attr('type', 'hidden').attr('name', Craft.csrfTokenName).attr('value', Craft.csrfTokenValue))
                .append($('<input/>').attr('type', 'hidden').attr('name', 'action').attr('value', 'commerce/shipping-methods/save'))
                .append($('<input/>').attr('type', 'hidden').attr('name', 'redirect').attr('value', '{{ ('commerce/store-management/' ~ store.handle ~ '/shippingmethods/{id}')|hash }}'))
                .append($('<input/>').attr('type', 'hidden').attr('name', 'name').attr('value', shippingOption.name))
                .append($('<input/>').attr('type', 'hidden').attr('name', 'handle').attr('value', gen.generateTargetValue(shippingOption.name)))
                .append($('<input/>').attr('type', 'hidden').attr('name', 'storeId').attr('value', {{ store.id }}))
                .appendTo(document.body)
                .submit();

        });
    {% endjs %}
    {% if false %}
    </script>{% endif %}
{% endblock %}
